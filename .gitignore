# ============================================
# Project-specific: Large data directories
# ============================================

# DNN model weights (user must prepare these)
models/CIFAR-10/*.pt
models/CIFAR-10/*.pth
models/MNIST/*.pt
models/MNIST/*.pth
models/Fashion-MNIST/*.pt
models/Fashion-MNIST/*.pth
models/TinyImageNet/*.pt
models/TinyImageNet/*.pth
!models/README.md
!models/*/README.md

# Image datasets (user must prepare these)
datasets/CIFAR10/
datasets/MNIST/
datasets/Fashion/
datasets/TinyImageNet/
!datasets/README.md

# Coverage matrices (generated by extract_multi_metric_coverage.py)
coverage_matrices/CIFAR-10/
coverage_matrices/MNIST/
coverage_matrices/Fashion-MNIST/
coverage_matrices/TinyImageNet/
coverage_matrices/*/*.npy
coverage_matrices/*/*.npz
coverage_matrices/*/*.pkl
!coverage_matrices/README.md
!coverage_matrices/*.py

# CP model checkpoints (generated by train.py)
cp_checkpoints/CIFAR10/
cp_checkpoints/MNIST/
cp_checkpoints/Fashion-MNIST/
cp_checkpoints/TinyImageNet/
cp_checkpoints/*/*.pt
cp_checkpoints/*/*.pth
cp_checkpoints/*/*.npz
cp_checkpoints/*/*.txt
!cp_checkpoints/README.md

# Experiment results (generated by eval scripts)
experiments/
exp*_results/
fuzz_results*/
!experiments/README.md

# Bayesian optimization outputs (generated by tune_weights.py)
bayesian/*.json
bayesian_optimal_weights*.json
!bayesian/README.md
!bayesian/*.py

